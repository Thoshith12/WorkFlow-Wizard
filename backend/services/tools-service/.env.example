# ── Tools Service ──────────────────────────────────────────────────────────────

# PostgreSQL (tools_db)
TOOLS_DB_DATABASE=tools_db
TOOLS_DB_USERNAME=tools_user
TOOLS_DB_PASSWORD=tools_password

# Service port
TOOLS_SERVICE_PORT=8002

# ── Sandbox Configuration ─────────────────────────────────────────────────────
SANDBOX_MODE=gvisor
# Total host RAM budget per sandbox incl. systrap (~400 MB → ~10 tools on 4 GB)
SANDBOX_MEMORY_MB=400
# Reserved for systrap/sentry + Python baseline (not usable by tool allocs)
SANDBOX_RUNTIME_OVERHEAD_MB=64
# Virtual address space (mmap / file-backed maps); may exceed RSS
SANDBOX_VIRTUAL_MEMORY_MB=2048
SANDBOX_EXEC_TIMEOUT_SECONDS=30
SANDBOX_QUEUE_TIMEOUT_SECONDS=15
SANDBOX_MAX_INFLIGHT=10
SANDBOX_MAX_QUEUED=20
SANDBOX_MAX_CONCURRENT_GLOBAL=50
SANDBOX_MAX_CONCURRENT_PER_TOOL=15
SANDBOX_IDLE_TIMEOUT_SECONDS=300
SANDBOX_MAX_LIFETIME_SECONDS=21600
SANDBOX_MAX_REQUESTS_PER_CONTAINER=5000
SANDBOX_REAPER_INTERVAL_SECONDS=60
SANDBOX_VENV_CACHE_SIZE=50
SANDBOX_PIDS_LIMIT=16
SANDBOX_TMPFS_SIZE_MB=10
SANDBOX_MAX_REQUIREMENTS=20
SANDBOX_MAX_OUTPUT_BYTES=1048576
