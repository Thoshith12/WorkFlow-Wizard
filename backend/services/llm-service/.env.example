# ── Required ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Redis (session store) ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Session config ─────────────────────────────────────────────────────────────
LLM_SESSION_TTL_SECONDS=3600
LLM_MAX_HISTORY_MESSAGES=50

# ── Service ────────────────────────────────────────────────────────────────────
LLM_SERVICE_PORT=8003
ENVIRONMENT=development
LOG_LEVEL=INFO
