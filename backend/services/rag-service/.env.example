# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SERVICE_NAME=rag-service
LOG_LEVEL=INFO

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# ── Service ───────────────────────────────────────────────────────────────────
RAG_SERVICE_PORT=8001
