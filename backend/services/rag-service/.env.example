# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SERVICE_NAME=rag-service
LOG_LEVEL=INFO

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── HuggingFace embedding model cache ─────────────────────────────────────────
# Disk cache for downloaded HuggingFace models (sentence-transformers).
# In Docker this path is mounted as a named volume so models persist across
# container restarts. Models are loaded into VRAM/RAM on demand per job and
# explicitly unloaded once all chunks for a data connector are embedded.
HF_HOME=/workspace/.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/workspace/.cache/huggingface/sentence-transformers

# ── Agentic chunking (Claude Haiku 4.5) ───────────────────────────────────────
# Required when chunking_strategy = "agentic". Set to your Anthropic API key.
ANTHROPIC_API_KEY=

# ── Service ───────────────────────────────────────────────────────────────────
RAG_SERVICE_PORT=8001
