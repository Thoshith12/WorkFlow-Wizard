# ── Frontend API Service URLs ──────────────────────────────────────────────────
#
# Copy this file to .env and fill in values for your environment.
# Leave blank to use the built-in proxy (Vite dev-server / nginx in prod).
# Set to an explicit origin ONLY when services are on a different domain.
#
# Example (local dev with proxy):
#   VITE_BACKEND_URL=
#   VITE_RAG_URL=
#   VITE_TOOLS_URL=
#
# Example (remote/staging):
#   VITE_BACKEND_URL=https://api.example.com
#   VITE_RAG_URL=https://rag.example.com
#   VITE_TOOLS_URL=https://tools.example.com

VITE_BACKEND_URL=
VITE_RAG_URL=
VITE_TOOLS_URL=
